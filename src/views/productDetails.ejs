<h2>
    <%= product.title %>
</h2>
<p>
    <%= product.description %>
</p>
<p>
    <%= product.price %> zł
</p>

<h3>Opinie</h3>
<% reviews.forEach(r=> { %>
    <p>
        <%= r.comment %> - <%= r.stars %>/5
    </p>
    <% }) %>

        <form method="POST" action="/review/<%= product._id %>">
            <textarea name="comment"></textarea>
            <select name="stars">
                <option>1</option>
                <option>2</option>
                <option>3</option>
                <option>4</option>
                <option>5</option>
            </select>
            <button>Dodaj opinię</button>
        </form>